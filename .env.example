# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - server-side ONLY, never exposed to the browser.
# Used for admin server actions (bulk import, storage bucket management).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used to build the public catalog + embed links shown in the admin UI
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: only needed if you enable the AI-assisted product description feature
AI_API_KEY=
